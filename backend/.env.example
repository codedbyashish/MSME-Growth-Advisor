# MSME Growth Advisor - Backend Environment Configuration Example
# Copy this file to .env and populate with production values

# Port for the Node/Express server
PORT=5000

# MongoDB Connection URI (e.g. MongoDB Atlas cluster string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/msmedb?retryWrites=true&w=majority

# Secret key for signing and verifying JWT tokens (Use a cryptographically secure 256-bit string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Allowed frontend client origin for CORS (e.g. production domain or comma-separated list)
CLIENT_URL=http://localhost:5173
